# One-way commands, in Claude Bash-pattern syntax. Both engines read this list.
[
    # Storage: destroys data with no undo.
    "zfs destroy *"
    "zfs rollback *"
    "zpool destroy *"
    "zpool labelclear *"
    "wipefs *"
    "mkfs*"
    "sgdisk *"
    "blkdiscard *"
    "dd *"
    "nixos-anywhere *"
    "disko *"
    # Firmware: a bad flash can brick the board, and there's no console to fix it.
    "fwupdmgr install *"
    "fwupdmgr update*"
    "fwupdmgr upgrade*"
    "fwupdmgr reinstall *"
    "fwupdmgr downgrade *"
    "flashrom *"
    "nvme fw-download *"
    "nvme fw-commit *"
    "nvme fw-activate *"
    "hdparm --fwdownload*"
    # Erases a whole drive in firmware, no snapshot can catch it.
    "nvme format *"
    "nvme sanitize *"
    "hdparm --security-erase*"
    "hdparm --security-erase-enhanced*"
    # Remote data with no undo.
    "rclone delete *"
    "rclone deletefile *"
    "rclone purge *"
    "rclone rmdir *"
    "rclone rmdirs *"
    "rclone sync *"
    "gh repo delete *"
    "gh release delete *"
    "git push --force origin main*"
    "git push -f origin main*"
    "git push --force origin master*"
    "git push -f origin master*"
  ]
