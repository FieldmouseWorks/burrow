+/**
+ * Whether whoever runs Renovate has it merge nothing in this run
+ * (BURROW_RENOVATE_NO_MERGE, in Renovate's own environment, which no
+ * repository's config reaches): no PR merged, no branch pushed onto its
+ * base, no platform automerge turned on. It still opens and updates PRs.
+ * Every way Renovate merges asks this, so no config (a package rule, a
+ * security fix's own `force`, a repository's) can turn merging back on.
+ */
+export function mergesHeld(): boolean {
+  return !!process.env.BURROW_RENOVATE_NO_MERGE;
+}
