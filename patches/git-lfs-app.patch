+package lfshttp
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/url"
+	"os"
+	"os/exec"
+	"strings"
+)
+
+// App authentication is enforced at the last HTTP boundary, including
+// redirects and object requests, after netrc and LFS's API authentication.
+func AppEnvironment() bool { return os.Getenv("GH_TOKEN_SOCKET") != "" }
+
+// AppAction keeps only credentials returned by the authenticated batch API,
+// never credentials from local configuration. Storage services use signed
+// URLs or these action headers rather than a GitHub installation token.
+type appActionKey struct{}
+type appAction struct {
+	origin  appOrigin
+	headers http.Header
+}
+
+type appOrigin struct{ scheme, host, port string }
+
+func originOf(u *url.URL) appOrigin {
+	scheme := strings.ToLower(u.Scheme)
+	port := u.Port()
+	if port == "" && scheme == "https" {
+		port = "443"
+	}
+	if port == "" && scheme == "http" {
+		port = "80"
+	}
+	return appOrigin{scheme: scheme, host: strings.ToLower(u.Hostname()), port: port}
+}
+
+func AppAction(req *http.Request, href string, headers map[string]string) (*http.Request, error) {
+	u, err := url.Parse(href)
+	if err != nil {
+		return nil, err
+	}
+	action := appAction{origin: originOf(u), headers: make(http.Header)}
+	for key, value := range headers {
+		action.headers.Set(key, value)
+	}
+	return req.WithContext(context.WithValue(req.Context(), appActionKey{}, action)), nil
+}
+
+type appTransport struct{ next http.RoundTripper }
+
+func (t appTransport) RoundTrip(original *http.Request) (*http.Response, error) {
+	req := original.Clone(original.Context())
+	u := *original.URL
+	req.URL = &u
+	req.URL.User = nil
+	req.Header.Del("Authorization")
+	req.Header.Del("Cookie")
+	req.Header.Del("Proxy-Authorization")
+	if req.URL.Scheme != "https" {
+		return nil, fmt.Errorf("acting as the App, LFS requires HTTPS")
+	}
+	action, hasAction := req.Context().Value(appActionKey{}).(appAction)
+	if hasAction {
+		if action.origin != originOf(req.URL) {
+			return nil, fmt.Errorf("acting as the App, LFS action cannot change origin")
+		}
+		for key := range action.headers {
+			req.Header.Del(key)
+		}
+		for key, values := range action.headers {
+			req.Header[key] = append([]string(nil), values...)
+		}
+	}
+	host := strings.ToLower(req.URL.Hostname())
+	if host != "github.com" {
+		if !hasAction {
+			return nil, fmt.Errorf("acting as the App, LFS requires a GitHub batch endpoint")
+		}
+		return t.next.RoundTrip(req)
+	}
+	// GitHub receives the installation credential even if a batch specified another.
+	req.Header.Del("Authorization")
+	req.Header.Del("Cookie")
+	req.Header.Del("Proxy-Authorization")
+	// The broker's credential entry point owns host and repository validation.
+	cmd := exec.Command("@gh-token@", "git-credential", "get")
+	cmd.Stdin = strings.NewReader("protocol=" + req.URL.Scheme + "\nhost=" + req.URL.Host + "\npath=" + strings.TrimPrefix(req.URL.EscapedPath(), "/") + "\n\n")
+	out, err := cmd.Output()
+	if err != nil {
+		return nil, fmt.Errorf("acting as the App, LFS credentials unavailable")
+	}
+	var user, password string
+	for _, line := range strings.Split(string(out), "\n") {
+		if v, ok := strings.CutPrefix(line, "username="); ok {
+			user = v
+		}
+		if v, ok := strings.CutPrefix(line, "password="); ok {
+			password = v
+		}
+	}
+	if user != "x-access-token" || password == "" {
+		return nil, fmt.Errorf("acting as the App, LFS has no installation token")
+	}
+	req.SetBasicAuth(user, password)
+	return t.next.RoundTrip(req)
+}
