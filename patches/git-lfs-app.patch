+package lfshttp
+
+import (
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+type appSend func(*http.Request) (*http.Response, error)
+
+func (f appSend) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestAppTransport(t *testing.T) {
+	socket := filepath.Join(t.TempDir(), "broker.sock")
+	listener, err := net.Listen("unix", socket)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	t.Setenv("GH_TOKEN_SOCKET", socket)
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			input, _ := io.ReadAll(conn)
+			if string(input) == "sam/r\n" {
+				io.WriteString(conn, "token ghs_app\n")
+			} else {
+				io.WriteString(conn, "refused no installation\n")
+			}
+			conn.Close()
+		}
+	}()
+	sent := 0
+	transport := appTransport{next: appSend(func(r *http.Request) (*http.Response, error) {
+		sent++
+		user, password, ok := r.BasicAuth()
+		if !ok || user != "x-access-token" || password != "ghs_app" {
+			t.Error("did not send only the App credential")
+		}
+		if r.Header.Get("X-Storage-Token") != "" {
+			t.Error("forwarded batch token to GitHub")
+		}
+		if r.URL.User != nil || r.Header.Get("Cookie") != "" || r.Header.Get("Proxy-Authorization") != "" {
+			t.Error("sent a user credential")
+		}
+		return &http.Response{StatusCode: 200, Body: http.NoBody}, nil
+	})}
+	for _, url := range []string{"https://github.com/sam/r.git/info/lfs", "https://user:secret@github.com/sam/r.git/info/lfs"} {
+		req, _ := http.NewRequest("GET", url, nil)
+		req.SetBasicAuth("user", "secret")
+		req.Header.Set("Cookie", "user=secret")
+		req.Header.Set("Proxy-Authorization", "secret")
+		if _, err := transport.RoundTrip(req); err != nil {
+			t.Fatal(err)
+		}
+		if u, _, _ := req.BasicAuth(); u != "user" {
+			t.Fatal("mutated original request")
+		}
+	}
+	// Both href rewriting and redirects must reject origin changes, since
+	// the path and query may contain credentials as well as the headers.
+	for _, redirect := range []bool{false, true} {
+		req, _ := http.NewRequest("GET", "https://storage.example/object", nil)
+		req.Header.Set("X-Storage-Token", "batch")
+		req, _ = AppAction(req, "https://storage.example/object", map[string]string{"X-Storage-Token": "batch"})
+		if redirect {
+			req, _ = newRequestForRetry(req, "https://github.com/sam/r.git/info/lfs/object")
+		} else {
+			u, _ := http.NewRequest("GET", "https://github.com/sam/r.git/info/lfs/object", nil)
+			req.URL = u.URL
+		}
+		if _, err := transport.RoundTrip(req); err == nil {
+			t.Fatal("accepted action origin change")
+		}
+	}
+	if sent != 2 {
+		t.Fatal(sent)
+	}
+	for _, url := range []string{"http://github.com/sam/r", "https://other.example/sam/r", "https://github.com/eve/r", "https://github.com/sam/r%0apath=eve/r"} {
+		req, _ := http.NewRequest("GET", url, nil)
+		if _, err := transport.RoundTrip(req); err == nil {
+			t.Fatalf("accepted %s", url)
+		}
+	}
+	os.Remove(socket)
+	req, _ := http.NewRequest("GET", "https://github.com/sam/r", nil)
+	if _, err := transport.RoundTrip(req); err == nil {
+		t.Fatal("accepted missing broker")
+	}
+	if sent != 2 {
+		t.Fatal("sent a request without broker authorization")
+	}
+}
+
+func TestAppStorageAction(t *testing.T) {
+	req, _ := http.NewRequest("GET", "https://storage.example/object", nil)
+	req.SetBasicAuth("storage", "batch")
+	req.Header.Set("X-Storage-Token", "batch")
+	req, _ = AppAction(req, req.URL.String(), map[string]string{"Authorization": req.Header.Get("Authorization"), "X-Storage-Token": "batch"})
+	req.SetBasicAuth("user", "netrc")
+	req.Header.Set("Cookie", "user=secret")
+	transport := appTransport{next: appSend(func(r *http.Request) (*http.Response, error) {
+		user, password, _ := r.BasicAuth()
+		if user != "storage" || password != "batch" || r.Header.Get("Cookie") != "" {
+			t.Error("did not isolate batch credentials")
+		}
+		return &http.Response{StatusCode: 200, Body: http.NoBody}, nil
+	})}
+	if _, err := transport.RoundTrip(req); err != nil {
+		t.Fatal(err)
+	}
+	sameOrigin, err := newRequestForRetry(req, "https://STORAGE.example:443/another-object")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := transport.RoundTrip(sameOrigin); err != nil {
+		t.Fatal(err)
+	}
+	redirected, err := newRequestForRetry(req, "https://other.example/object")
+	if err != nil {
+		t.Fatal(err)
+	}
+	transport.next = appSend(func(r *http.Request) (*http.Response, error) {
+		t.Fatal("sent action credentials across origins")
+		return nil, nil
+	})
+	if _, err := transport.RoundTrip(redirected); err == nil {
+		t.Fatal("accepted cross-origin redirect")
+	}
+}
+
+func TestAppSignedActionOrigins(t *testing.T) {
+	// All action constructors ultimately send through this boundary. A token
+	// may be in any path component or query, so origin changes fail entirely.
+	transport := appTransport{next: appSend(func(r *http.Request) (*http.Response, error) {
+		t.Fatal("sent signed action to a rewritten or redirected origin")
+		return nil, nil
+	})}
+	for _, method := range []string{"GET", "PUT", "HEAD", "PATCH", "POST"} {
+		for _, original := range []string{"https://storage.example/capability-secret/object", "https://storage.example/object?token=batch-secret"} {
+			for _, target := range []string{"https://mirror.example/", "https://github.com/sam/r/", "https://storage.example:444/"} {
+				req, _ := http.NewRequest(method, original, nil)
+				req, _ = AppAction(req, original, nil)
+				redirected, err := newRequestForRetry(req, target+"capability-secret/object?token=batch-secret")
+				if err != nil {
+					t.Fatal(err)
+				}
+				if _, err := transport.RoundTrip(redirected); err == nil {
+					t.Fatal("accepted signed redirect")
+				}
+				rewritten, _ := http.NewRequest(method, target+"capability-secret/object?token=batch-secret", nil)
+				rewritten, _ = AppAction(rewritten, original, nil)
+				if _, err := transport.RoundTrip(rewritten); err == nil {
+					t.Fatal("accepted signed rewrite")
+				}
+			}
+		}
+	}
+}
