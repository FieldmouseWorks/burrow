diff --git a/config/src/state_tests.rs b/config/src/state_tests.rs
index 8dad010..05f7973 100644
--- a/config/src/state_tests.rs
+++ b/config/src/state_tests.rs
@@ -9,0 +10,23 @@ fn test_user_config_path(temp_dir: &TempDir, file_name: &str) -> AbsolutePathBuf
+#[test]
+fn job_capabilities_strict_mcp_uses_only_session_servers_and_fields() {
+    let directory = TempDir::new().unwrap();
+    let user = ConfigLayerEntry::new(
+        ConfigLayerSource::User { file: test_user_config_path(&directory, "config.toml"), profile: None },
+        toml::from_str("[mcp_servers.outside]\ncommand = 'outside'\n[mcp_servers.inside]\ncommand = 'old'\nenabled = false\n[mcp_servers.inside.env]\nOLD = 'outside'\n").unwrap(),
+    );
+    let session: TomlValue =
+        toml::from_str("strict_mcp_config = true\n[mcp_servers.inside]\ncommand = 'inside'\n")
+            .unwrap();
+    let expected = session.get("mcp_servers").unwrap().clone();
+    let stack = ConfigLayerStack::new(
+        vec![
+            user,
+            ConfigLayerEntry::new(ConfigLayerSource::SessionFlags, session),
+        ],
+        ConfigRequirements::default(),
+        ConfigRequirementsToml::default(),
+    )
+    .unwrap();
+    assert_eq!(stack.effective_config().get("mcp_servers"), Some(&expected));
+}
+
diff --git a/linux-sandbox/src/bwrap_tests.rs b/linux-sandbox/src/bwrap_tests.rs
index 9f53e2c..d4200ef 100644
--- a/linux-sandbox/src/bwrap_tests.rs
+++ b/linux-sandbox/src/bwrap_tests.rs
@@ -14,0 +15,27 @@ use tempfile::TempDir;
+#[test]
+fn job_capabilities_device_roots_are_devices_without_directory_metadata() {
+    let policy = FileSystemSandboxPolicy::restricted(vec![FileSystemSandboxEntry::new(
+        AbsolutePathBuf::from_absolute_path("/dev/null")
+            .unwrap()
+            .into(),
+        FileSystemAccessMode::Write,
+    )]);
+    let roots = policy.get_writable_roots_with_cwd_inheriting_root_metadata(Path::new("/"));
+    assert_eq!(roots.len(), 1);
+    assert!(roots[0].protected_metadata_names.is_empty());
+    let args = create_bwrap_command_args(
+        vec!["/bin/true".to_string()],
+        &policy,
+        Path::new("/"),
+        Path::new("/"),
+        BwrapOptions::default(),
+    )
+    .unwrap()
+    .args;
+    assert!(
+        args.windows(3)
+            .any(|args| args == ["--dev-bind", "/dev/null", "/dev/null"])
+    );
+    assert!(!args.iter().any(|arg| arg.starts_with("/dev/null/")));
+}
