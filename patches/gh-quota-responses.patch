+package api
+
+// BURROW_GH_RESPONSES is an opt-in private side channel for schedulers.
+// CLI formatting and repository data never become HTTP response evidence.
+import (
+	"bytes"
+	"encoding/json"
+ "encoding/base64"
+ "context"
+ "fmt"
+ "net"
+	"io"
+	"net/http"
+	"os"
+	"sync"
+	"time"
+)
+
+type quotaTransport struct {
+	inner http.RoundTripper
+	file  string
+	mu    sync.Mutex
+}
+type quotaBody struct {
+	io.Reader
+	io.Closer
+}
+
+func quotaNetwork(inner http.RoundTripper) http.RoundTripper {
+    if socket, owner := os.Getenv("GH_TOKEN_SOCKET"), os.Getenv("BURROW_GH_PROXY_OWNER"); socket != "" && owner != "" {
+        return &quotaRelay{inner: inner, socket: socket, owner: owner}
+    }
+    return inner
+}
+func quotaClient(client *http.Client) *http.Client {
+	client.Transport = quotaResponses(client.Transport)
+	return client
+}
+func quotaResponses(inner http.RoundTripper) http.RoundTripper {
+	if file := os.Getenv("BURROW_GH_RESPONSES"); file != "" {
+		return &quotaTransport{inner: inner, file: file}
+	}
+	return inner
+}
+func (q *quotaTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	resp, err := q.inner.RoundTrip(req)
+	if err != nil {
+		return resp, err
+	}
+	record := struct {
+		Status  int         `json:"status"`
+		Headers [][2]string `json:"headers"`
+		Body    string      `json:"body"`
+		At      int64       `json:"at"`
+	}{Status: resp.StatusCode, At: time.Now().Unix(), Body: "{}"}
+	for _, key := range []string{"x-ratelimit-remaining", "x-ratelimit-reset", "retry-after"} {
+		if val := resp.Header.Get(key); val != "" {
+			record.Headers = append(record.Headers, [2]string{key, val})
+		}
+	}
+	if resp.Body != nil && (resp.StatusCode == 403 || resp.StatusCode == 429 || (req.URL.Scheme == "https" && req.URL.Hostname() == "api.github.com" && (req.URL.Port() == "" || req.URL.Port() == "443") && req.URL.Path == "/graphql")) {
+		body, _ := io.ReadAll(io.LimitReader(resp.Body, 16*1024*1024))
+		resp.Body = quotaBody{io.MultiReader(bytes.NewReader(body), resp.Body), resp.Body}
+		// Retain API errors only, never a successful GraphQL data payload.
+		var errors struct {
+			Message string          `json:"message,omitempty"`
+			Errors  json.RawMessage `json:"errors,omitempty"`
+		}
+		if json.Unmarshal(body, &errors) == nil {
+			encoded, _ := json.Marshal(errors)
+			record.Body = string(encoded)
+		}
+	}
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	// Observation failure must not change a completed request's outcome.
+	if file, err := os.OpenFile(q.file, os.O_WRONLY|os.O_APPEND, 0600); err == nil {
+		_ = json.NewEncoder(file).Encode(record)
+		_ = file.Close()
+	}
+	return resp, nil
+}
+
+// Each request is executed by the host token service. Response metadata and
+// installation identity are recorded there, outside job-writable state.
+type quotaRelay struct {
+    inner http.RoundTripper
+    socket, owner string
+}
+func (q *quotaRelay) RoundTrip(req *http.Request) (*http.Response,error) {
+    // Downloads redirected to a different host stay with the normal client.
+    if req.URL.Scheme != "https" || req.URL.Hostname() != "api.github.com" || (req.URL.Port() != "" && req.URL.Port() != "443") { return q.inner.RoundTrip(req) }
+    conn, err := (&net.Dialer{}).DialContext(req.Context(), "unix", q.socket)
+    if err != nil { return nil,err }
+    defer conn.Close()
+    if deadline, ok := req.Context().Deadline(); ok { _ = conn.SetDeadline(deadline) } else { _ = conn.SetDeadline(time.Now().Add(100*time.Second)) }
+    stop := context.AfterFunc(req.Context(),func(){conn.Close()}); defer stop()
+    var data []byte
+    if req.Body != nil { data,err=io.ReadAll(io.LimitReader(req.Body,64*1024*1024+1)); if err != nil {return nil,err}; if len(data)>64*1024*1024{return nil,fmt.Errorf("API request exceeds relay limit")} }
+    headers := [][2]string{}
+    for key,values := range req.Header { if key == "Authorization" {continue}; for _,value:=range values {headers=append(headers,[2]string{key,value})} }
+    _,err=io.WriteString(conn,"http\n"); if err!=nil{return nil,err}
+    wire:=struct{Owner string `json:"owner"`; Method string `json:"method"`; Path string `json:"path"`; Headers [][2]string `json:"headers"`; Body string `json:"body"`}{q.owner,req.Method,req.URL.RequestURI(),headers,base64.StdEncoding.EncodeToString(data)}
+    if err=json.NewEncoder(conn).Encode(wire);err!=nil{return nil,err}
+    if c,ok:=conn.(*net.UnixConn);ok{_ = c.CloseWrite()}
+    var reply struct{Status int; Headers [][2]string; Body string}
+    if err=json.NewDecoder(io.LimitReader(conn,96*1024*1024)).Decode(&reply);err!=nil{return nil,err}
+    data,err=base64.StdEncoding.DecodeString(reply.Body);if err!=nil{return nil,err}
+    response:= &http.Response{StatusCode:reply.Status,Status:fmt.Sprintf("%d %s",reply.Status,http.StatusText(reply.Status)),Proto:"HTTP/1.1",ProtoMajor:1,ProtoMinor:1,Header:make(http.Header),Body:io.NopCloser(bytes.NewReader(data)),ContentLength:int64(len(data)),Request:req}
+    for _,header:=range reply.Headers{response.Header.Add(header[0],header[1])}
+    return response,nil
+}
