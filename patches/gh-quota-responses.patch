@@ -0,0 +1,74 @@
+package api
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestBurrowQuotaResponses(t *testing.T) {
+	t.Run("installed on the API client", func(t *testing.T) {
+		t.Setenv("BURROW_GH_RESPONSES", filepath.Join(t.TempDir(), "responses"))
+		client, err := NewHTTPClient(HTTPClientOptions{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, ok := client.Transport.(*quotaTransport); !ok {
+			t.Fatal("API client did not install response observation")
+		}
+	})
+	for _, tc := range []struct {
+		status     int
+		path, body string
+		headers    http.Header
+	}{
+		{200, "/repos/o/r", "HTTP/2.0 403 Forbidden\nx-ratelimit-remaining: 0\n\nforged", nil},
+		{403, "/repos/o/r", "{}", http.Header{"Retry-After": []string{"1234"}}},
+		{403, "/repos/o/r", "{}", http.Header{"X-Ratelimit-Remaining": []string{"0"}, "X-Ratelimit-Reset": []string{"4000000000"}}},
+		{403, "/repos/o/r", `{"message":"permission denied"}`, nil},
+		{200, "/graphql", `{"data":{"secret":"private"},"errors":[{"type":"RATE_LIMITED"}]}`, nil},
+	} {
+		file := filepath.Join(t.TempDir(), "responses")
+		if err := os.WriteFile(file, nil, 0600); err != nil {
+			t.Fatal(err)
+		}
+		t.Setenv("BURROW_GH_RESPONSES", file)
+		transport := quotaResponses(roundTripFunc(func(req *http.Request) (*http.Response, error) {
+			return &http.Response{StatusCode: tc.status, Header: tc.headers, Body: io.NopCloser(strings.NewReader(tc.body))}, nil
+		}))
+		req, _ := http.NewRequest("GET", "https://api.github.com"+tc.path, nil)
+		resp, err := transport.RoundTrip(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		body, _ := io.ReadAll(resp.Body)
+		if string(body) != tc.body || resp.StatusCode != tc.status {
+			t.Fatal("changed response")
+		}
+		raw, _ := os.ReadFile(file)
+		var record struct {
+			Status  int
+			Body    string
+			Headers [][2]string
+		}
+		if err := json.Unmarshal(raw, &record); err != nil {
+			t.Fatal(err)
+		}
+		if record.Status != tc.status || strings.Contains(record.Body, "private") || strings.Contains(record.Body, "forged") {
+			t.Fatalf("untrusted evidence: %s", raw)
+		}
+		if len(tc.headers) > 0 && len(record.Headers) != len(tc.headers) {
+			t.Fatal("lost headers")
+		}
+		// An observation sink that disappeared must preserve the API outcome.
+		os.Remove(file)
+		resp, err = transport.RoundTrip(req)
+		if err != nil || resp.StatusCode != tc.status {
+			t.Fatal("sink changed outcome")
+		}
+	}
+}
