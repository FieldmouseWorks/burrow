diff --git a/linux-sandbox/src/bwrap_tests.rs b/linux-sandbox/src/bwrap_tests.rs
index 9f53e2c..570e91b 100644
--- a/linux-sandbox/src/bwrap_tests.rs
+++ b/linux-sandbox/src/bwrap_tests.rs
@@ -14,0 +15,27 @@ use tempfile::TempDir;
+#[test]
+fn explicit_device_roots_are_devices_without_directory_metadata() {
+    let policy = FileSystemSandboxPolicy::restricted(vec![FileSystemSandboxEntry::new(
+        AbsolutePathBuf::from_absolute_path("/dev/null")
+            .unwrap()
+            .into(),
+        FileSystemAccessMode::Write,
+    )]);
+    let roots = policy.get_writable_roots_with_cwd_inheriting_root_metadata(Path::new("/"));
+    assert_eq!(roots.len(), 1);
+    assert!(roots[0].protected_metadata_names.is_empty());
+    let args = create_bwrap_command_args(
+        vec!["/bin/true".to_string()],
+        &policy,
+        Path::new("/"),
+        Path::new("/"),
+        BwrapOptions::default(),
+    )
+    .unwrap()
+    .args;
+    assert!(
+        args.windows(3)
+            .any(|args| args == ["--dev-bind", "/dev/null", "/dev/null"])
+    );
+    assert!(!args.iter().any(|arg| arg.starts_with("/dev/null/")));
+}
