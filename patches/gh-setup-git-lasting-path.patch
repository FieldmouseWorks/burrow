+// lastingPath is the gh a helper written to the user's git config names. A
+// path in the Nix store is gone once the store is collected, and the helper
+// with it, after the blank entry above has cut off the system's helpers: the
+// system profile's gh outlives every build, and a gh found on PATH does too.
+func lastingPath(self string) string {
+	if !strings.HasPrefix(self, "/nix/store/") {
+		return self
+	}
+	const profile = "/run/current-system/sw/bin/gh"
+	if _, err := os.Stat(profile); err == nil {
+		return profile
+	}
+	return "gh"
+}
